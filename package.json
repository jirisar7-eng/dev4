{
  "name": "tmpr-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:boundaries": "pnpm --filter @tmpr/boundary-gate build && node packages/boundary-gate/dist/cli.js",
    "scaffold:module": "pnpm --filter @tmpr/module-engine build && node packages/module-engine/dist/scaffold/cli.js",
    "dev": "pnpm --filter @synthesis/public dev",
    "start": "pnpm --filter @synthesis/public start"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
