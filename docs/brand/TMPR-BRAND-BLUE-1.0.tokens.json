{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Tata ma pravo Design Tokens — Blue Brand Foundation 1.0",
  "version": "1.0.0",
  "taskId": "TMPR-NEWDEV-20260911-BRAND-001",
  "projectKey": "tata-ma-pravo",
  "status": "APPROVED_FROZEN",
  "color": {
    "brand": {
      "primary": {
        "$value": "#2563EB",
        "$type": "color",
        "$description": "Hlavní značková modrá pro primární interakce, CTA a klíčové akcenty"
      },
      "dark": {
        "$value": "#1D4ED8",
        "$type": "color",
        "$description": "Tmavší modrá pro hover stavy tlačítek a aktivní navigaci"
      },
      "deep": {
        "$value": "#1E40AF",
        "$type": "color",
        "$description": "Hluboká modrá pro active/pressed stavy a hlavičky"
      },
      "light": {
        "$value": "#DBEAFE",
        "$type": "color",
        "$description": "Světlý modrý podklad pro badge a jemná ohraničení"
      },
      "soft": {
        "$value": "#EFF6FF",
        "$type": "color",
        "$description": "Ultra jemná modrá pro podbarvení informačních panelů"
      }
    },
    "text": {
      "primary": {
        "$value": "#0F172A",
        "$type": "color",
        "$description": "Primární text s vysokým kontrastem dle WCAG AAA"
      },
      "secondary": {
        "$value": "#475569",
        "$type": "color",
        "$description": "Sekundární doplňkový text a popisy polí"
      },
      "muted": {
        "$value": "#64748B",
        "$type": "color",
        "$description": "Ztlumený text pro metadata, štítky a placeholdery"
      }
    },
    "background": {
      "default": {
        "$value": "#F8FAFC",
        "$type": "color",
        "$description": "Výchozí barva plátna a podkladu stránek"
      }
    },
    "surface": {
      "default": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Barva povrchu karet, panelů a formulářových prvků"
      }
    },
    "border": {
      "default": {
        "$value": "#E2E8F0",
        "$type": "color",
        "$description": "Výchozí jemné ohraničení karet a dělicí linky"
      }
    },
    "state": {
      "success": {
        "$value": "#15803D",
        "$type": "color",
        "$description": "Stav schváleno, v pořádku, shoda rodičů"
      },
      "warning": {
        "$value": "#B45309",
        "$type": "color",
        "$description": "Stav blížící se lhůta, varování, čekání"
      },
      "danger": {
        "$value": "#B91C1C",
        "$type": "color",
        "$description": "Stav kritická lhůta, zamítnutí, vysoký konflikt"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "primary": {
        "$value": "Inter Variable",
        "$type": "fontFamily"
      },
      "fallback": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "sans-serif"
        ],
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "h1": {
        "mobile": {
          "$value": "34px",
          "$type": "dimension"
        },
        "desktop": {
          "$value": "48px",
          "$type": "dimension"
        }
      },
      "h2": {
        "mobile": {
          "$value": "26px",
          "$type": "dimension"
        },
        "desktop": {
          "$value": "32px",
          "$type": "dimension"
        }
      },
      "h3": {
        "mobile": {
          "$value": "20px",
          "$type": "dimension"
        },
        "desktop": {
          "$value": "24px",
          "$type": "dimension"
        }
      },
      "h4": {
        "mobile": {
          "$value": "18px",
          "$type": "dimension"
        },
        "desktop": {
          "$value": "20px",
          "$type": "dimension"
        }
      },
      "bodyLarge": {
        "$value": "18px",
        "$type": "dimension"
      },
      "body": {
        "$value": "16px",
        "$type": "dimension"
      },
      "metadata": {
        "$value": "14px",
        "$type": "dimension"
      },
      "micro": {
        "$value": "12px",
        "$type": "dimension"
      }
    },
    "minContinuousTextSize": {
      "$value": "14px",
      "$type": "dimension",
      "$description": "Žádný souvislý text nesmí mít méně než 14px"
    }
  },
  "radius": {
    "xs": {
      "$value": "6px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "20px",
      "$type": "dimension"
    },
    "card": {
      "$value": "12px",
      "$type": "dimension"
    },
    "button": {
      "$value": "8px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgba(15, 23, 42, 0.05)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgba(15, 23, 42, 0.07), 0 2px 4px -2px rgba(15, 23, 42, 0.05)",
      "$type": "shadow"
    }
  },
  "touch": {
    "minTarget": {
      "$value": "44px",
      "$type": "dimension",
      "$description": "Minimální dotyková plocha tlačítka na mobilu (44x44px)"
    }
  },
  "guards": {
    "gradientsAllowed": false,
    "cardInsideCardInsideCardAllowed": false,
    "emojiAsIconsAllowed": false,
    "iconLibrary": "lucide-react",
    "unapprovedFontsBanned": [
      "Playfair Display",
      "Plus Jakarta Sans"
    ]
  }
}